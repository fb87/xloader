# xloader v9 relocated PIC acceptance sample.
#
# Materialize the concrete bootable manifest with:
#   nix build .#sample-config-aarch64
# Build the final bundle with:
#   nix build .#sample-bundle-aarch64

format = 1

[bundle]
output = "build/qemu-aarch64-relocated.xbundle.elf"

[platform]
arch = "aarch64"

[loader]
image = "@XLOADER_BIN@"
metadata = "@XLOADER_META@"

[xen]
image = "@XEN_BIN@"
metadata = "@XEN_META@"
cmdline = "console=dtuart dtuart=serial0 conswitch=ax"

# Placement is a host-side policy. xloader itself is linked position-independently.
[layout]
loader_base = "0x42080000"
xen_base = "0x42400000"
payload_alignment = "2M"

[[domain]]
name = "guest0"
kernel = "@LINUX_IMAGE@"
kernel_format = "linux-image"
initrd = "@INITRAMFS@"
memory = "256M"
vcpus = 1
cmdline = "console=ttyAMA0 rdinit=/init xloader.domain=guest0"
vpl011 = true

[[domain]]
name = "guest1"
kernel = "@LINUX_IMAGE@"
kernel_format = "linux-image"
initrd = "@INITRAMFS@"
memory = "256M"
vcpus = 1
cmdline = "console=ttyAMA0 rdinit=/init xloader.domain=guest1"
vpl011 = true

# Hardware passthrough is configured per domain with host-FDT paths:
#
# [[domain.passthrough]]
# path = "/soc/i2c@12340000"
#
# v9 carries these paths in the descriptor and validates that they exist in
# the boot-time machine DT. External phandle dependencies are rejected conservatively. MMIO/IOMMU
# resource-assignment policy is intentionally a later milestone.
