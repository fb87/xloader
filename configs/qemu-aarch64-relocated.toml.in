# xloader v10 bootable QEMU/AArch64 sample.
#
# guest0 receives the QEMU virt PL031 RTC as a real Xen dom0less
# passthrough device. guest1 is the control guest without passthrough.

format = 1

[bundle]
output = "build/qemu-aarch64.xbundle.elf"

[platform]
arch = "aarch64"

[loader]
image = "@XLOADER_BIN@"
metadata = "@XLOADER_META@"

[xen]
image = "@XEN_BIN@"
metadata = "@XEN_META@"
cmdline = "console=dtuart dtuart=serial0 conswitch=ax"

[layout]
loader_base = "0x42080000"
xen_base = "0x40400000"
payload_alignment = "2M"

[[domain]]
name = "guest0"
kernel = "@LINUX_IMAGE@"
kernel_format = "linux-image"
initrd = "@INITRAMFS@"
memory = "256M"
vcpus = 1
cmdline = "console=ttyAMA0 rdinit=/init xloader.domain=guest0"
vpl011 = true

# QEMU virt PL031 RTC. QEMU currently exposes it at /pl031@9010000,
# MMIO 0x09010000..0x09010fff, GIC SPI 2, level-high.
#
# QEMU virt does not provide an SMMU for this sysbus device, therefore the
# sample explicitly opts in to Xen's non-IOMMU test assignment. Do not copy
# this policy to real DMA-capable hardware.
[[domain.passthrough]]
path = "/pl031@9010000"
force_assign_without_iommu = true
strip_external_dependencies = true
mmio = { host = "0x09010000", guest = "same", size = "4K" }
irq = { type = "spi", number = 2, flags = 4 }

[[domain]]
name = "guest1"
kernel = "@LINUX_IMAGE@"
kernel_format = "linux-image"
initrd = "@INITRAMFS@"
memory = "256M"
vcpus = 1
cmdline = "console=ttyAMA0 rdinit=/init xloader.domain=guest1"
vpl011 = true
